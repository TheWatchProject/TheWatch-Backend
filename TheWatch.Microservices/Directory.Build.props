<Project>
  <PropertyGroup>
    <!-- .NET Stack First: Target .NET 10 & C# 13/14 Latest -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13.0</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    
    <!-- Compiler Enforcement of XML Documentation Generation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    
    <!-- High-Performance & Deterministic CI Builds -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' Or '$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>